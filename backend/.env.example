# Copy this file to .env and fill in real values.
# Any store left blank will just make that one store report an error in the
# app — the rest still work.

# Kroger Product API (https://developer.kroger.com) — client_credentials app.
# Also powers Harris Teeter (a Kroger Co. banner on this same official API —
# see krogerLiveScraper.ts) — no separate credentials needed for it.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Aldi, Trader Joe's, and Sprouts need no configuration — each resolves the
# nearest real store directly from the shopper's ZIP code at search time
# (see backend/src/services/locators/).

# Assistant intent classifier (Phase 4.1 — see
# docs/assistant_ai_integration_review.md and
# backend/src/services/intentClassifierService.ts). Optional: leaving
# LLM_API_KEY blank disables the LLM tier entirely — the assistant falls
# back to the deterministic keyword router for every request, exactly
# like before this classifier existed. When set, expects an
# OpenAI-compatible chat-completions endpoint (JSON response_format).
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# Optional cost control on the LLM tier above — a global cap (not
# per-shopper; this route has no auth to key one off of) on real provider
# calls per minute across every request this server handles. A request
# that hits the limit falls back to the deterministic keyword router,
# exactly like an unconfigured/unavailable LLM tier already does — never
# an error surfaced to a shopper. Defaults to 20/min if unset.
LLM_RATE_LIMIT_PER_MINUTE=20

# AI Product Quality Scanner (Feature 1) + optional expiration-date
# detection (Feature 2) — see backend/src/services/visionQualityService.ts.
# Reuses the same LLM_API_KEY/LLM_API_URL/LLM_MODEL above (gpt-4o-mini is
# already vision-capable); leaving LLM_API_KEY blank disables this feature
# entirely — the app reports "quality check unavailable" rather than
# faking a verdict. A separate, lower rate limit than the intent
# classifier's, since a vision call is a materially more expensive request.
VISION_RATE_LIMIT_PER_MINUTE=10

# Port the server listens on
PORT=3001
